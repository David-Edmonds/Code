# Yahoo OAuth app credentials. Create a Yahoo Sports developer app and use the exact callback below.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://127.0.0.1:8765/auth/callback

# League URL: https://football.fantasysports.yahoo.com/f1/810161/10
YAHOO_LEAGUE_ID=810161
YAHOO_TEAM_ID=10

# Draft setup. These can also be changed in the browser.
LEAGUE_TEAMS=10
DRAFT_SLOT=7
DRAFT_ROUNDS=16
SCORING_FORMAT=ppr
SEASON_YEAR=2026
POLL_SECONDS=5

# Optional. This is separate from a ChatGPT subscription and uses OpenAI API billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
